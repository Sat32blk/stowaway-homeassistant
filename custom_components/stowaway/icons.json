{
  "entity": {
    "switch": {
      "awake": {
        "default": "mdi:power-sleep",
        "state": {
          "on": "mdi:power"
        }
      }
    },
    "sensor": {
      "status": {
        "default": "mdi:docker"
      },
      "apps_asleep": {
        "default": "mdi:sleep"
      },
      "memory_freed": {
        "default": "mdi:memory"
      },
      "sleep_mode": {
        "default": "mdi:power-sleep"
      },
      "cpu": {
        "default": "mdi:cpu-64-bit"
      },
      "memory": {
        "default": "mdi:memory"
      },
      "last_woken_by": {
        "default": "mdi:gesture-tap"
      }
    },
    "select": {
      "keep_awake": {
        "default": "mdi:coffee",
        "state": {
          "off": "mdi:coffee-off-outline"
        }
      }
    }
  },
  "services": {
    "keep_awake": {
      "service": "mdi:coffee"
    },
    "release": {
      "service": "mdi:coffee-off"
    },
    "sleep": {
      "service": "mdi:power-sleep"
